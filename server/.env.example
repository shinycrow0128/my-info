# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/resume_tracker

# API port
PORT=5000

# Comma separated list of allowed frontend origins.
# `chrome-extension://*` lets the Chrome extension post applications; replace it
# with the extension's real chrome-extension://<id> to pin a single extension.
CORS_ORIGIN=http://localhost:5173,chrome-extension://*

# Where uploaded resumes are stored (relative to server/)
UPLOAD_DIR=uploads

# Max upload size in megabytes
MAX_UPLOAD_MB=15

# Max size of the generator ZIP the extension posts to /:id/package
MAX_PACKAGE_MB=25

# The python that runs resume_fill.py. It needs python-docx installed.
# PYTHON_BIN=python

# Resume templates and the fill script. Both default to the Chrome extension
# folder in this repo, which is where the extension itself reads them from.
# TEMPLATES_DIR=../Chatgpt Extension/Temp
# RESUME_FILL_SCRIPT=../Chatgpt Extension/resume_fill.py

# How many resume_fill.py runs may happen at once, and how long one may take.
PACKAGE_CONCURRENCY=3
PACKAGE_TIMEOUT_MS=120000
